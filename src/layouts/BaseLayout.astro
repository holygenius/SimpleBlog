---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'My Astro Blog' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>
  <body class="flex flex-col min-h-screen">

    <!-- Header / Nav -->
    <header class="pt-8 pb-4 px-4 mb-4">
        <div class="max-w-5xl mx-auto w-full flex flex-col md:flex-row justify-between items-end border-b-2 border-[#333] pb-2">
            <div class="cursor-pointer mb-4 md:mb-0">
                <a href="/" class="text-5xl md:text-6xl mb-0 leading-none select-none no-underline text-white">DevLog</a>
                <p class="text-gray-500 uppercase tracking-widest text-sm mt-1">Personal Portfolio</p>
            </div>
            
            <nav class="flex gap-2 md:gap-6 overflow-x-auto w-full md:w-auto pb-1">
                <a href="/" class="nav-item">Home</a>
                <a href="/articles" class="nav-item">Articles</a>
                <a href="/projects" class="nav-item">Projects</a>
                <a href="/downloads" class="nav-item">Files</a>
                <a href="/about" class="nav-item">About Me</a>
            </nav>
        </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow px-4 pb-12 w-full max-w-5xl mx-auto">
      <slot />
    </main>

    <footer class="mt-auto py-8 text-center text-gray-600 text-sm">
        <p>&copy; 2024 DEVLOG. DESIGNED IN METRO STYLE.</p>
    </footer>

    <script>
        lucide.createIcons();
    </script>
  </body>
</html>
