---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="DevLog - Home">
  <h2 class="text-4xl font-light mb-8 text-blue-500">Welcome to DevLog</h2>
  <p class="text-lg leading-relaxed text-gray-300">
    This is the homepage of your new Metro UI inspired Astro blog. Explore the articles, projects, and more!
  </p>

  <div class="mt-12">
    <a href="/articles" class="metro-btn-fill py-3 px-6 text-xl">View All Articles</a>
  </div>
</BaseLayout>