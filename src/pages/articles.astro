---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="DevLog - Articles">
  <h2 class="text-4xl font-light mb-8 text-blue-500">All Articles</h2>
            
  <div class="space-y-1"> <!-- Tight spacing for list look -->
      <!-- Article Item -->
      <div class="group bg-[#1d1d1d] hover:bg-[#2d89ef] hover:pl-6 transition-all duration-200 p-4 cursor-pointer flex justify-between items-center border-l-4 border-transparent hover:border-white">
          <div>
              <h3 class="text-xl group-hover:text-white">Advanced CSS Grid Techniques</h3>
              <p class="text-gray-500 group-hover:text-white/80 text-sm">Mastering the grid layout for complex dashboards.</p>
          </div>
          <span class="text-gray-600 group-hover:text-white text-sm">NOV 20</span>
      </div>

      <!-- Article Item -->
      <div class="group bg-[#1d1d1d] hover:bg-[#00a300] hover:pl-6 transition-all duration-200 p-4 cursor-pointer flex justify-between items-center border-l-4 border-transparent hover:border-white">
          <div>
              <h3 class="text-xl group-hover:text-white">Rust for JavaScript Developers</h3>
              <p class="text-gray-500 group-hover:text-white/80 text-sm">Understanding ownership and borrowing.</p>
          </div>
          <span class="text-gray-600 group-hover:text-white text-sm">OCT 05</span>
      </div>

      <!-- Article Item -->
      <div class="group bg-[#1d1d1d] hover:bg-[#ee1111] hover:pl-6 transition-all duration-200 p-4 cursor-pointer flex justify-between items-center border-l-4 border-transparent hover:border-white">
          <div>
              <h3 class="text-xl group-hover:text-white">Deploying Docker Containers</h3>
              <p class="text-gray-500 group-hover:text-white/80 text-sm">A simple guide to ECS and Kubernetes.</p>
          </div>
          <span class="text-gray-600 group-hover:text-white text-sm">AUG 28</span>
      </div>
  </div>
</BaseLayout>
